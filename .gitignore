# =============================================================================
# EX188 Practice Lab Suite — .gitignore
# Only dummy practice strings inside task/setup scripts may be committed.
# Never commit generated TLS certs/keys, htpasswd, auth.json, or image tarballs.
# =============================================================================

# Generated TLS private keys, certificates, and CSRs
certs/
*.key
*.crt
*.pem
*.csr
*.srl
*.p12
*.pfx

# Registry authentication & client credential files
*htpasswd*
registries/
auth.json
*auth.json
.docker/config.json

# Learner progress, active seed state, and mock-exam session locks (~/.lab)
.lab/
progress.json
exam_session.json
current-task.md
current-exam.md

# Offline image archives generated by prefetch-images.sh
offline-images/
*.tar
*.tar.gz
*.tgz
*.oci

# Real credentials & local environment overrides
*.secret
*.token
.env
.env.*
credentials*
*kubeconfig*

# Runtime / language build caches
node_modules/
__pycache__/
*.pyc
metrics-agent

# Temporary files & editor swap/backup artifacts
tmp/
*.tmp
*.bak
*.orig
*.swp
*.swo
*~
.#*
.DS_Store
Thumbs.db
